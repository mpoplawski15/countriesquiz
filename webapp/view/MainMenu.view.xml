<mvc:View
	controllerName="mpp.countries.controller.MainMenu"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
>
	<Bar class="sapContrastPlus" design="Header">
		<contentRight>
			<Button 
				id="loginButton"
				text="{= ${/oUser/loggedIn} ? ${/oUser/username} : ${i18n>buttonLogIn} }"
				icon="{= ${/oUser/loggedIn} ? 'sap-icon://person-placeholder' : 'sap-icon://business-card' }"
				press="handleLoginPress"
				type="Emphasized"
			/>
		</contentRight>
	</Bar>

	<HBox direction="Column" class="sapUiLargeMarginTop">
		<VBox alignItems="Center" width="100%" height="100%">
			<core:Icon src="sap-icon://world" size="200px" class="sapUiMediumMargin" />
			<Title titleStyle="H1" text="TerraQuiz" class="sapUiMediumMargin" />
			<Button
				id="idMenuButtonPlay"
				text="{i18n>buttonPlay}"
				width="200px"
				class="sapUiSmallMargin"
				press="handlePlay" />

			<Button
				id="idMenuButtonSettings"
				text="{i18n>buttonSettings}"
				width="200px"
				class="sapUiSmallMargin"
				press="handleOpenSettingsDialog"
			/>

			<Button
				id="idMenuButtonRanking"
				text="{i18n>buttonOpenRanking}"
				width="200px"
				class="sapUiSmallMargin"
				press="handleOpenRankingDialog"
			/>

			<Button
				id="idMenuButtonHelp"
				text="{i18n>buttonHelp}"
				width="200px"
				class="sapUiSmallMargin"
				press="handleOpenHelpDialog"
			/>
		</VBox>
	</HBox>


</mvc:View>