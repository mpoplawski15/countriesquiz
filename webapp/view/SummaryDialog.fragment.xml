<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="idDialogSummary"
        title="{i18n>titleSummary}"
        titleAlignment="Center"
        horizontalScrolling="false"
        contentWidth="25%">
        <content>
            <VBox width="100%" height="100%" justifyContent="Center"
                alignItems="Center"
            >
                <FormattedText
                    id="idScoreText"
                    htmlText=""
                    class="sapUiSmallMargin largeFont"
                    textAlign="Center" />
            </VBox>
        </content>
        <buttons>
            <Button
                text="{i18n>buttonOpenRanking}"
                press="handleOpenRankingDialog"
                type="Emphasized" />
            <Button
                text="{i18n>buttonPlayAgain}"
                press="handlePlayAgainDialog"
                type="Emphasized" />
            <Button
                text="{i18n>buttonGoBack}"
                press="handleGoBackDialog"
                type="Emphasized" />
            <Button 
                text="Save score" 
                press="handleSaveScore" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>