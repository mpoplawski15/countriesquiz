<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<Dialog
		id="loginRegisterDialog"
		title="{= ${/oRegister/isLogin} ? ${i18n>titleLogIn} : ${i18n>titleRegister} }"
		contentWidth="400px"
		class="sapUiResponsiveMargin">
		<beginButton>
			<Button
				text="{= ${/oRegister/isLogin} ? ${i18n>buttonLogIn} : ${i18n>buttonRegister} }"
				type="Emphasized"
				press="onSubmitPress"/>
		</beginButton>
		<endButton>
			<Button
				text="{i18n>buttonCancel}"
				press="onCancelPress"/>
		</endButton>
		<content>
			<VBox class="sapUiSmallMargin">
				<f:SimpleForm
					editable="true"
					layout="ResponsiveGridLayout"
					labelSpanXL="4"
					labelSpanL="4"
					labelSpanM="4"
					labelSpanS="12"
					adjustLabelSpan="false"
					emptySpanXL="0"
					emptySpanL="0"
					emptySpanM="0"
					emptySpanS="0"
					columnsXL="1"
					columnsL="1"
					columnsM="1"
					singleContainerFullSize="false">
					<f:content>
						<!-- Login Form -->
						<VBox visible="{/oRegister/isLogin}">
							<Label text="{i18n>labelEmailUsername}" required="true"/>
							<Input
								id="loginUsername"
								placeholder="{i18n>placeholderEmailUsername}"
								value="{/oRegister/username}"/>
							
							<Label text="{i18n>labelPassword}" required="true"/>
							<Input
								id="loginPassword"
								type="Password"
								placeholder="{i18n>placeholderPassword}"
								value="{/oRegister/password}"/>
							
							<CheckBox 
								id="rememberMe"
								text="{i18n>labelRememberMe}"
								selected="{/oRegister/rememberMe}"/>
							
							<Link
								text="{i18n>linkForgotPassword}"
								press="onForgotPasswordPress"
								class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
						</VBox>
						
						<!-- Register Form -->
						<VBox visible="{= !${/oRegister/isLogin}}">
							<Label text="{i18n>labelEmail}" required="true"/>
							<Input
								id="registerEmail"
								type="Email"
								placeholder="{i18n>placeholderEmail}"
								value="{/oRegister/email}"/>
							
							<Label text="{i18n>labelUsername}" required="true"/>
							<Input
								id="registerUsername"
								placeholder="{i18n>placeholderUsername}"
								value="{/oRegister/username}"/>
							
							<Label text="{i18n>labelPassword}" required="true"/>
							<Input
								id="registerPassword"
								type="Password"
								placeholder="{i18n>placeholderPassword}"
								value="{/oRegister/password}"/>
							
							<Label text="{i18n>labelConfirmPassword}" required="true"/>
							<Input
								id="confirmPassword"
								type="Password"
								placeholder="{i18n>placeholderConfirmPassword}"
								value="{/oRegister/confirmPassword}"/>
							
							<CheckBox
								id="termsAccept"
								text="{i18n>labelAcceptTerms}"
								selected="{/oRegister/termsAccepted}"
								required="true"/>
						</VBox>
					</f:content>
				</f:SimpleForm>
				
				<Link
					text="{= ${/oRegister/isLogin} ? ${i18n>linkRegister} : ${i18n>linkLogIn} }"
					press="handleToggleLoginRegister"
					class="sapUiSmallMarginTop"/>
			</VBox>
		</content>
	</Dialog>
</core:FragmentDefinition>