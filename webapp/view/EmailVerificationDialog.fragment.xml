
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		id="idEmailVerificationDialog"
		title="{i18n>emailVerification}"
		contentWidth="30rem">
		<VBox class="sapUiSmallMargin">
			<Text text="{i18n>emailVerificationText}" class="sapUiSmallMarginBottom" />
			<!-- <Text text="{emailVerification>/email}" class="sapUiSmallMarginBottom" /> -->
		</VBox>
		 <buttons>
           <Button text="{i18n>resendVerificationEmail}" press="onResendVerificationPress" class="sapUiTinyMarginEnd" type="Emphasized" />
		   <Button text="{i18n>buttonClose}" press="onCloseVerificationDialog" />
        </buttons>
	</Dialog>
</core:FragmentDefinition>