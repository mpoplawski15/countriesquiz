
<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<Dialog
		id="idEmailVerificationDialog"
		title="{i18n>emailVerification}"
		contentWidth="20rem">
		<VBox class="sapUiSmallMargin">
			<Text text="{i18n>emailVerificationText}" class="sapUiSmallMarginBottom" />
			<Text text="{emailVerification>/email}" class="sapUiSmallMarginBottom" />
			<HBox justifyContent="SpaceBetween" width="100%" class="sapUiSmallMarginBottom">
				<Button
					text="{i18n>resendVerificationEmail}"
					press="onResendVerificationPress"
					class="sapUiTinyMarginEnd"
					type="Emphasized" />
				<Button
					text="{i18n>close}"
					press="onCloseVerificationDialog" />
			</HBox>
		</VBox>
	</Dialog>
</core:FragmentDefinition>