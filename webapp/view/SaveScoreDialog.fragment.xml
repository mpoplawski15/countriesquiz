<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="idDialogSaveScore"
        title="{i18n>titleSaveScore}"
        titleAlignment="Center"
        horizontalScrolling="false"
        contentWidth="20%">
        <content>
            <form:SimpleForm class="sapUiTinyMargin" layout="ResponsiveGridLayout">
                <Label text="{i18n>enterYourNick}" labelFor="idInputPlayerNick"></Label>
                <Input id="idInputPlayerNick" width="50%"></Input>
            </form:SimpleForm>
        </content>
        <buttons>
            <Button
                text="Confirm"
                press="handleConfirmSaveScoreDialog"
                type="Emphasized" />
            <Button
                text="Cancel"
                press="handleCloseSaveScoreDialog"
                type="Emphasized" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>